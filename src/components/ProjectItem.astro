---
interface Props {
	title: string;
	url: string;
	year?: number;
	description?: string;
	tags?: string[];
}

const { title, url } = Astro.props as Props;
---

<a href={url} target="_blank" rel="noopener noreferrer" class="underline-link">
	<span class="label">{title}</span>
	<span class="underline" aria-hidden="true"></span>
</a>

<style>
	.underline-link {
		position: relative;
		display: inline-block;
		width: max-content;
		padding: 6px 0;
		color: inherit;
		text-decoration: none;
	}

	.label {
		font-family: "Playfair Display", serif;
		font-size: clamp(20px, 3vw, 24px);
		color: var(--color-link);
	}

	.underline {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 5px;
		height: 1px;
		background: var(--color-link);
		transform: scaleX(0);
		transform-origin: left;
	}

	.underline-link:hover .underline,
	.underline-link:focus-visible .underline {
		transform: scaleX(1);
	}

	@media (prefers-reduced-motion: no-preference) {
		.underline {
			transition: transform 0.3s ease;
		}
	}
</style>
