---
import UnderlineLink from "./UnderlineLink.astro";

interface Props {
  title: string;
  url: string;
  year?: number;
  description?: string;
  tags?: string[];
}

const { title, url } = Astro.props as Props;
---

<UnderlineLink href={url} variant="project" external>
  {title}
</UnderlineLink>
