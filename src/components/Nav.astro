---
import { site } from "../site";
import UnderlineLink from "./UnderlineLink.astro";

interface Props {
  variant: "home" | "sub";
  current?: "about" | "projects";
}

const { variant, current } = Astro.props;

const homeItems = [
  { label: "About", href: "/about" },
  { label: "Projects", href: "/projects" },
  { label: "Contact", href: `mailto:${site.email}` },
];

const subItems: { key: "about" | "projects"; label: string; href: string }[] = [
  { key: "about", label: "About", href: "/about" },
  { key: "projects", label: "Projects", href: "/projects" },
];

// on some OS in mobile, "*" gets converted to emoji
const plainTextAsterisk = "\u{2733}\u{FE0E}";
---

{variant === "home" ? (
  <nav aria-label="Primary">
    <ul class="home-list">
      {homeItems.map((item) => (
        <li>
          <a href={item.href}>
            <span class="label">{item.label}</span>
            <span class="mark" aria-hidden="true">
              {plainTextAsterisk}
            </span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
) : (
  <nav aria-label="Primary">
    <ul class="sub-list">
      <li>
        <a href="/" aria-label="Home" class="back">
          ←
        </a>
      </li>
      {subItems.map((item) =>
        item.key === current ? (
          <li>
            <span class="current" aria-current="page">
              {item.label}
            </span>
          </li>
        ) : (
          <li>
            <UnderlineLink href={item.href} variant="nav">
              {item.label}
            </UnderlineLink>
          </li>
        ),
      )}
      <li>
        <UnderlineLink href={`mailto:${site.email}`} variant="nav">
          Contact
        </UnderlineLink>
      </li>
    </ul>
  </nav>
)}

<style>
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .home-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .home-list a {
    display: flex;
    align-items: center;
    gap: 12px;
    width: max-content;
    padding: 8px 0;
  }

  .home-list .label {
    font-family: var(--font-heading);
    font-size: clamp(22px, 3vw, 32px);
    color: var(--color-link);
  }

  .home-list .mark {
    font-size: clamp(26px, 3.6vw, 40px);
    font-weight: 700;
    line-height: 1;
    display: inline-block;
    color: var(--color-accent);
    opacity: 0;
    transform-origin: center;
  }

  .home-list a:hover .mark,
  .home-list a:focus-visible .mark {
    opacity: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    .home-list .mark {
      transition: opacity 0.15s ease;
    }

    .home-list a:hover .mark,
    .home-list a:focus-visible .mark {
      animation: ast-pop 0.5s ease;
    }
  }

  @keyframes ast-pop {
    0% {
      transform: rotate(0deg) scale(1);
    }
    45% {
      transform: rotate(16deg) scale(1.35);
    }
    100% {
      transform: rotate(0deg) scale(1);
    }
  }

  .sub-list {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .sub-list li {
    display: flex;
    align-items: center;
  }

  .back {
    font-family: var(--font-heading);
    font-size: 20px;
    line-height: 1;
    padding: 8px 0;
    color: var(--color-link);
  }

  .back:hover,
  .back:focus-visible {
    color: var(--color-dim);
  }

  .current {
    font-family: var(--font-heading);
    font-size: 16px;
    color: var(--color-dim);
    padding: 8px 0;
  }
</style>
