---
import { site } from "../site";
import UnderlineLink from "./UnderlineLink.astro";

interface Props {
  variant: "home" | "sub";
  current?: "about" | "projects";
}

const { variant, current } = Astro.props;

const homeItems = [
  { label: "About", href: "/about" },
  { label: "Projects", href: "/projects" },
  { label: "Contact", href: `mailto:${site.email}` },
];

const subItems: { key: "about" | "projects"; label: string; href: string }[] = [
  { key: "about", label: "About", href: "/about" },
  { key: "projects", label: "Projects", href: "/projects" },
];
---

{variant === "home" ? (
  <nav aria-label="Primary">
    <ul class="home-list">
      {homeItems.map((item) => (
        <li>
          <a href={item.href}>
            <span class="label">
              {item.label}
              <span class="underline" aria-hidden="true" />
            </span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
) : (
  <nav aria-label="Primary">
    <ul class="sub-list">
      <li>
        <a href="/" aria-label="Home" class="back">
          ←
        </a>
      </li>
      {subItems.map((item) =>
        item.key === current ? (
          <li>
            <span class="current" aria-current="page">
              {item.label}
            </span>
          </li>
        ) : (
          <li>
            <UnderlineLink href={item.href} variant="nav">
              {item.label}
            </UnderlineLink>
          </li>
        ),
      )}
      <li>
        <UnderlineLink href={`mailto:${site.email}`} variant="nav">
          Contact
        </UnderlineLink>
      </li>
    </ul>
  </nav>
)}

<style>
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .home-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .home-list a {
    display: flex;
    width: max-content;
    padding: 8px 0;
  }

  .home-list .label {
    position: relative;
    font-size: clamp(22px, 3vw, 32px);
    color: var(--color-link);
  }

  .home-list .underline {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
  }

  .home-list a:hover .underline,
  .home-list a:focus-visible .underline {
    transform: scaleX(1);
  }

  @media (prefers-reduced-motion: no-preference) {
    .home-list .underline {
      transition: transform 0.3s ease;
    }
  }

  .sub-list {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .sub-list li {
    display: flex;
    align-items: center;
  }

  .back {
    font-size: 20px;
    line-height: 1;
    padding: 8px 0;
    color: var(--color-link);
  }

  .back:hover,
  .back:focus-visible {
    color: var(--color-dim);
  }

  .current {
    font-size: 16px;
    color: var(--color-dim);
    padding: 8px 0;
  }
</style>
