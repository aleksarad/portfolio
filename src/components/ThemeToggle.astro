<!-- prettier-ignore -->
<button type="button" data-theme-toggle>
  <span class="sr-only">Switch to </span><span class="to-light">light</span><span class="to-dark">dark</span><span class="sr-only"> theme</span>
</button>

<script is:inline>
  document.querySelectorAll("[data-theme-toggle]").forEach((button) => {
    button.addEventListener("click", () => {
      var current =
        document.documentElement.getAttribute("data-theme") ||
        (matchMedia("(prefers-color-scheme: light)").matches
          ? "light"
          : "dark");
      var next = current === "dark" ? "light" : "dark";
      document.documentElement.setAttribute("data-theme", next);
      try {
        localStorage.setItem("theme", next);
      } catch (e) {}
    });
  });
</script>

<style>
  button {
    font-family: var(--font-secondary);
    font-size: 13px;
    letter-spacing: 0.04em;
    color: var(--color-dim);
    background: none;
    border: none;
    padding: 10px 0;
    margin: 0;
    cursor: pointer;
  }

  button:hover,
  button:focus-visible {
    color: var(--color-link);
  }

  @media (prefers-reduced-motion: no-preference) {
    button {
      transition: color 0.2s ease;
    }
  }

  .to-light,
  .to-dark {
    position: relative;
  }

  .to-light {
    display: inline;
  }

  .to-dark {
    display: none;
  }

  /* Decorative sun/moon mark that appears on hover/focus. */
  .to-light::after,
  .to-dark::after {
    position: absolute;
    width: 25px;
    height: 25px;
    top: -10px;
    left: 0;
    font-size: 24px;
    color: var(--color-accent);
    opacity: 0;
    pointer-events: none;
  }

  /* \FE0E forces text (not emoji) presentation; the "/ ''" alt text hides the
     glyph from screen readers. The plain declaration is a fallback for
     browsers without alt-text support. */
  .to-light::after {
    content: "\2600\FE0E";
    content: "\2600\FE0E" / "";
  }

  .to-dark::after {
    /* to-do: make own moon with css? */
    content: "\263D";
    content: "\263D" / "";
  }

  button:hover .to-light::after,
  button:hover .to-dark::after,
  button:focus-visible .to-light::after,
  button:focus-visible .to-dark::after {
    opacity: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    .to-light::after,
    .to-dark::after {
      transition:
        opacity 1s ease,
        transform 1s ease;
    }

    button:hover .to-light::after,
    button:hover .to-dark::after,
    button:focus-visible .to-light::after,
    button:focus-visible .to-dark::after {
      transform: translateY(-35px);
    }
  }

  @media (prefers-color-scheme: light) {
    .to-light {
      display: none;
    }

    .to-dark {
      display: inline;
    }
  }

  :global(html[data-theme="light"]) .to-light {
    display: none;
  }

  :global(html[data-theme="light"]) .to-dark {
    display: inline;
  }

  :global(html[data-theme="dark"]) .to-light {
    display: inline;
  }

  :global(html[data-theme="dark"]) .to-dark {
    display: none;
  }
</style>
