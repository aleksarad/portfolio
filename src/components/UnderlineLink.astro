---
interface Props {
  href: string;
  variant: "nav" | "project";
  external?: boolean;
}

const { href, variant, external = false } = Astro.props as Props;
---

<a
  href={href}
  class:list={["underline-link", variant]}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
>
  <span class="label">
    <slot />
  </span>
  <span class="underline" aria-hidden="true"></span>
  {external && <span class="sr-only"> (opens in new tab)</span>}
</a>

<style>
  .underline-link {
    position: relative;
    display: inline-block;
    width: max-content;
    color: inherit;
    text-decoration: none;
  }

  .label {
    font-family: var(--font-heading);
    color: var(--color-link);
  }

  .underline {
    position: absolute;
    left: 0;
    right: 0;
    height: 1px;
    transform: scaleX(0);
    transform-origin: left;
  }

  .underline-link:hover .underline,
  .underline-link:focus-visible .underline {
    transform: scaleX(1);
  }

  @media (prefers-reduced-motion: no-preference) {
    .underline {
      transition: transform 0.3s ease;
    }
  }

  .nav {
    padding: 8px 0;
  }

  .nav .label {
    font-size: 16px;
  }

  .nav .underline {
    bottom: 8px;
    background: var(--color-accent);
  }

  .project {
    padding: 6px 0;
  }

  .project .label {
    font-size: clamp(20px, 3vw, 24px);
  }

  .project .underline {
    bottom: 5px;
    background: var(--color-link);
  }
</style>
